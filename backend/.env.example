# Prosper backend — sample production env file.
# Copy to .env (gitignored) and replace each placeholder.

MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
DB_NAME=prosper_prod
REDIS_URL=redis://cache.prosper.internal:6379/0

# Auth + MFA
JWT_SECRET=change-me-to-a-256-bit-random-string
MFA_FERNET_KEY=run_cryptography.fernet.Fernet.generate_key_and_paste_here

# Emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@prosper.foundation
DEMO_MODE=true

# AiPrise (KYB/KYC)
AIPRISE_API_KEY_SANDBOX=
AIPRISE_API_KEY_PRODUCTION=
AIPRISE_KYC_TEMPLATE_ID=
AIPRISE_KYB_TEMPLATE_ID=
AIPRISE_WEBHOOK_SECRET=

# TRM Labs (wallet screening)
TRM_LABS_API_KEY=

# Alfred (Onramp/Offramp)
ALFRED_MODE=production
ALFRED_API_KEY=
ALFRED_API_BASE=
ALFRED_WEBHOOK_SECRET=
ALFRED_CALLBACK_URL=https://api.prosper.foundation/api/v1/webhooks/alfred

# Prosper backend (Stellar minter)
PROSPER_MODE=production
PROSPER_API_BASE=https://api.prosper.example/v1
PROSPER_API_USER=
PROSPER_API_PASS=

# Observability (mocked-friendly — leave empty to disable)
SENTRY_DSN=
DATADOG_API_KEY=
PROSPER_ENV=production

# CORS
CORS_ORIGINS=https://app.prosper.foundation,https://admin.prosper.foundation

# Cookies
COOKIE_SECURE=true

# Phase 13 — Ramp provider abstraction
RAMP_PROVIDER=alfred
RAMP_PROVIDER_MODE=mock
ANDES_GATEWAY_URL=http://andes-gateway:8090
GATEWAY_INTERNAL_TOKEN=dev-internal-token-change-me
