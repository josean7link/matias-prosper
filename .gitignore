# NOTE: the line above used to say ".env files must be tracked in git" —
# that was only true for Emergent's own deploy pipeline (it injects prod
# secrets by reading tracked .env files). We're deploying via GitHub +
# Render/Vercel now, where secrets are set in each dashboard's Environment
# panel instead. Tracking .env here would leak real credentials to the repo.
.env
.env.*
*.env
memory/PROD_DEPLOY.md
credentials.json
*.pem
*.pem.*
*.key
.credentials
frontend/.next/cache/webpack/client-production/0.pack
codigo_limpio.zip
