# =============================================================================
# Prosper Platform — Phase 0 environment configuration template
# =============================================================================
# Copy to .env at each app root and fill in the values. Do NOT commit .env.

# ───── Backend (apps/api / backend/) ─────
MONGO_URL=mongodb://localhost:27017
DB_NAME=prosper_phase0
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=*

# JWT signing key — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Resend (email) — sign up at https://resend.com and create an API key.
# Until configured the OTP code is logged to stdout for dev convenience.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Set true in production (HTTPS) so the session cookie is Secure.
COOKIE_SECURE=false

# ───── Frontend (apps/admin / frontend/) ─────
# Same-origin /api paths handled by Next.js rewrites (dev) and the kubernetes
# ingress (preview / production). Optionally override for cross-origin testing:
NEXT_PUBLIC_API_BASE=

# ───── Future phases ─────
# STRIPE_API_KEY=
# SUMSUB_API_KEY=
# PROSPER_STELLAR_API_BASE=
# PROSPER_STELLAR_API_USER=
# PROSPER_STELLAR_API_PASS=
